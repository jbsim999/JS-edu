{
  "exerciseId": "numbers-and-precision-exercise",
  "contentRevision": "draft-1",
  "graderRevision": "numbers-and-precision-checks-v1",
  "cases": [
    {
      "id": "integer-minor-units",
      "label": "최소 화폐 단위의 정수로 곱셈·합산한다",
      "probe": "observe(submission.calculateAmount([{unitPrice:199,quantity:3},{unitPrice:1,quantity:1}]));",
      "expected": {
        "ok": true,
        "kind": "number",
        "total": "598"
      }
    },
    {
      "id": "empty-and-zero",
      "label": "빈 목록과 0 수량을 처리한다",
      "probe": "observe([submission.calculateAmount([]),submission.calculateAmount([{unitPrice:500,quantity:0},{unitPrice:0,quantity:99}])]);",
      "expected": [
        {
          "ok": true,
          "kind": "number",
          "total": "0"
        },
        {
          "ok": true,
          "kind": "number",
          "total": "0"
        }
      ]
    },
    {
      "id": "safe-number-boundary",
      "label": "안전 정수 경계는 유지하고 곱셈·합계 초과는 거부한다",
      "probe": "observe([submission.calculateAmount([{unitPrice:Number.MAX_SAFE_INTEGER,quantity:1}]),submission.calculateAmount([{unitPrice:Number.MAX_SAFE_INTEGER,quantity:2}]),submission.calculateAmount([{unitPrice:Number.MAX_SAFE_INTEGER,quantity:1},{unitPrice:1,quantity:1}])]);",
      "expected": [
        {
          "ok": true,
          "kind": "number",
          "total": "9007199254740991"
        },
        {
          "ok": false,
          "reason": "range"
        },
        {
          "ok": false,
          "reason": "range"
        }
      ]
    },
    {
      "id": "exact-bigint",
      "label": "안전 정수보다 큰 BigInt 금액을 손실 없이 계산한다",
      "probe": "observe(submission.calculateAmount([{unitPrice:9007199254740993n,quantity:2n},{unitPrice:7n,quantity:3n}]));",
      "expected": {
        "ok": true,
        "kind": "bigint",
        "total": "18014398509482007"
      }
    },
    {
      "id": "mixed-numeric-types",
      "label": "필드 간·행 간 Number/BigInt 혼합을 거부한다",
      "probe": "observe([submission.calculateAmount([{unitPrice:2n,quantity:3}]),submission.calculateAmount([{unitPrice:2,quantity:3},{unitPrice:2n,quantity:3n}])]);",
      "expected": [
        {
          "ok": false,
          "reason": "mixed"
        },
        {
          "ok": false,
          "reason": "mixed"
        }
      ]
    },
    {
      "id": "invalid-ranges",
      "label": "소수·음수·NaN·무한대·unsafe 정수를 거부한다",
      "probe": "observe([1.5,-1,NaN,Infinity,9007199254740992].map(unitPrice=>submission.calculateAmount([{unitPrice,quantity:1}])).concat([submission.calculateAmount([{unitPrice:1n,quantity:-1n}]),submission.calculateAmount([{unitPrice:1,quantity:0.5}])]));",
      "expected": [
        {
          "ok": false,
          "reason": "range"
        },
        {
          "ok": false,
          "reason": "range"
        },
        {
          "ok": false,
          "reason": "range"
        },
        {
          "ok": false,
          "reason": "range"
        },
        {
          "ok": false,
          "reason": "range"
        },
        {
          "ok": false,
          "reason": "range"
        },
        {
          "ok": false,
          "reason": "range"
        }
      ]
    },
    {
      "id": "invalid-types-precedence",
      "label": "문자열·불리언·누락은 타입 오류로 보고한다",
      "probe": "observe(['12',true,undefined,null].map(unitPrice=>submission.calculateAmount([{unitPrice,quantity:1}])).concat([submission.calculateAmount([{unitPrice:1n,quantity:2},{unitPrice:'3',quantity:1}])]));",
      "expected": [
        {
          "ok": false,
          "reason": "type"
        },
        {
          "ok": false,
          "reason": "type"
        },
        {
          "ok": false,
          "reason": "type"
        },
        {
          "ok": false,
          "reason": "type"
        },
        {
          "ok": false,
          "reason": "type"
        }
      ]
    },
    {
      "id": "frozen-input",
      "label": "행과 원본 목록을 변경하지 않는다",
      "probe": "const lines=Object.freeze([Object.freeze({unitPrice:40,quantity:2})]); const result=submission.calculateAmount(lines); observe({result,lines});",
      "expected": {
        "result": {
          "ok": true,
          "kind": "number",
          "total": "80"
        },
        "lines": [
          {
            "unitPrice": 40,
            "quantity": 2
          }
        ]
      }
    },
    {
      "id": "bigint-zero",
      "label": "BigInt의 0도 BigInt 경로를 유지한다",
      "probe": "observe(submission.calculateAmount([{unitPrice:0n,quantity:200n}]));",
      "expected": {
        "ok": true,
        "kind": "bigint",
        "total": "0"
      }
    }
  ],
  "observationMode": "callback"
}

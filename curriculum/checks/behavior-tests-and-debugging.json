  "graderRevision": "behavior-tests-and-debugging-checks-v1",
  "cases": [
    {
      "id": "correct-factory-passes",
      "label": "정상 구현의 다섯 행동을 모두 통과시킨다",
      "probe": "function good(start){let count=start;return{value:()=>count,increment(delta=1){count+=delta;return count;},reset(){count=start;return count;}}} observe(submission.auditCounterFactory(good));",
      "expected": [
        {
          "id": "initial-value",
          "passed": true
        },
        {
          "id": "increment-and-default",
          "passed": true
        },
        {
          "id": "zero-and-negative",
          "passed": true
        },
        {
          "id": "reset-origin",
          "passed": true
        },
        {
          "id": "independent-instances",
          "passed": true
        }
      ]
    },
    {
      "id": "shared-state-fails",
      "label": "인스턴스 간 공유 상태 오답을 찾아낸다",
      "probe": "let count; function shared(start){count=start;return{value:()=>count,increment(delta=1){count+=delta;return count;},reset(){count=start;return count;}}} observe(submission.auditCounterFactory(shared));",
      "expected": [
        {
          "id": "initial-value",
          "passed": true
        },
        {
          "id": "increment-and-default",
          "passed": true
        },
        {
          "id": "zero-and-negative",
          "passed": true
        },
        {
          "id": "reset-origin",
          "passed": true
        },
        {
          "id": "independent-instances",
          "passed": false
        }
      ]
    },
    {
      "id": "falsy-default-fails",
      "label": "0을 기본값으로 바꾸는 오답을 경계값으로 찾는다",
      "probe": "function wrongDefault(start){let count=start;return{value:()=>count,increment(delta){count+=(delta||1);return count;},reset(){count=start;return count;}}} observe(submission.auditCounterFactory(wrongDefault));",
      "expected": [
        {
          "id": "initial-value",
          "passed": true
        },
        {
          "id": "increment-and-default",
          "passed": true
        },
        {
          "id": "zero-and-negative",
          "passed": false
        },
        {
          "id": "reset-origin",
          "passed": true
        },
        {
          "id": "independent-instances",
          "passed": true
        }
      ]
    },
    {
      "id": "wrong-reset-fails",
      "label": "시작값 대신 0으로 초기화하는 회귀를 찾는다",
      "probe": "function wrongReset(start){let count=start;return{value:()=>count,increment(delta=1){count+=delta;return count;},reset(){count=0;return count;}}} observe(submission.auditCounterFactory(wrongReset));",
      "expected": [
        {
          "id": "initial-value",
          "passed": true
        },
        {
          "id": "increment-and-default",
          "passed": true
        },
        {
          "id": "zero-and-negative",
          "passed": true
        },
        {
          "id": "reset-origin",
          "passed": false
        },
        {
          "id": "independent-instances",
          "passed": false
        }
      ]
    },
    {
      "id": "return-contract-fails",
      "label": "상태 변경만 맞고 반환이 틀린 구현도 거부한다",
      "probe": "function wrongReturn(start){let count=start;return{value:()=>count,increment(delta=1){count+=delta;},reset(){count=start;return count;}}} observe(submission.auditCounterFactory(wrongReturn));",
      "expected": [
        {

{
  "exerciseId": "language-host-boundaries-exercise",
  "contentRevision": "draft-1",
  "graderRevision": "language-host-boundaries-checks-v1",
  "cases": [
    {
      "id": "language-web-node",
      "label": "언어·문서·파일 API를 구분한다",
      "probe": "observe(submission.classifyApis(['Promise','document','node:fs'], ['Promise','document']));",
      "expected": [
        {
          "name": "Promise",
          "layer": "language",
          "available": true
        },
        {
          "name": "document",
          "layer": "web",
          "available": true
        },
        {
          "name": "node:fs",
          "layer": "node",
          "available": false
        }
      ]
    },
    {
      "id": "observed-support",
      "label": "표준 소속과 제공 여부를 독립적으로 판단한다",
      "probe": "observe(submission.classifyApis(['Promise','fetch','setTimeout'], ['fetch','setTimeout']));",
      "expected": [
        {
          "name": "Promise",
          "layer": "language",
          "available": false
        },
        {
          "name": "fetch",
          "layer": "web",
          "available": true
        },
        {
          "name": "setTimeout",
          "layer": "host",
          "available": true
        }
      ]
    },
    {
      "id": "unknown-is-explicit",
      "label": "알 수 없는 API를 지원한다고 추측하지 않는다",
      "probe": "observe(submission.classifyApis(['unknown','__proto__','constructor'], ['unknown','__proto__','constructor']));",
      "expected": [
        {
          "name": "unknown",
          "layer": "unknown",
          "available": false
        },
        {
          "name": "__proto__",
          "layer": "unknown",
          "available": false
        },
        {
          "name": "constructor",
          "layer": "unknown",
          "available": false
        }
      ]
    },
    {
      "id": "empty-request",
      "label": "빈 진단은 빈 목록이다",
      "probe": "observe(submission.classifyApis([], ['Promise']));",
      "expected": []
    },
    {
      "id": "order-and-duplicates",
      "label": "요청 순서와 중복을 보존한다",
      "probe": "observe(submission.classifyApis(['node:path','Map','JSON','Map'], ['Map','node:path']));",
      "expected": [
        {
          "name": "node:path",
          "layer": "node",
          "available": true
        },
        {
          "name": "Map",
          "layer": "language",
          "available": true
        },
        {
          "name": "JSON",
          "layer": "language",
          "available": false
        },
        {
          "name": "Map",
          "layer": "language",
          "available": true
        }
      ]
    },
    {
      "id": "inputs-unchanged",
      "label": "환경 프로필과 요청을 변경하지 않는다",
      "probe": "const requested=Object.freeze(['document','Promise']); const provided=Object.freeze(['Promise']); const result=submission.classifyApis(requested,provided); observe({ result, requested, provided });",
      "expected": {
        "result": [
          {
            "name": "document",
            "layer": "web",
            "available": false
          },
          {
            "name": "Promise",
            "layer": "language",
            "available": true
          }
        ],
        "requested": [
          "document",
          "Promise"
        ],
        "provided": [
          "Promise"
        ]
      }
    }
  ],
  "observationMode": "callback"
}
